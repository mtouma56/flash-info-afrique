# ============================================
# Flash Info Afrique - Variables d'environnement
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs
# IMPORTANT: Ne commitez JAMAIS le fichier .env !

# ============================================
# SUPABASE CONFIGURATION (Serveur)
# ============================================
# Obtenez ces valeurs depuis votre projet Supabase : Settings > API

# URL de votre projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme (publique) - utilisée pour les opérations côté client
SUPABASE_ANON_KEY=votre-anon-key-ici

# Clé de rôle service (secrète) - utilisée côté serveur uniquement
# ATTENTION: Cette clé bypass RLS, ne jamais l'exposer côté client !
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key-ici

# ============================================
# SUPABASE CONFIGURATION (Client - Vite)
# ============================================
# Les variables VITE_ sont accessibles côté client (exposées dans le bundle)
# Utilisez les mêmes valeurs que SUPABASE_URL et SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-anon-key-ici

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port du serveur Express
# En développement : 3001 (Vite utilise 3000)
# En production : 3000 (ou celui configuré par votre hébergeur)
PORT=3001

# Environnement d'exécution
# development | production
NODE_ENV=development

# URL publique du site (utilisée pour le sitemap, les liens canoniques, etc.)
# En développement : http://localhost:3000
# En production : https://flashinfoafrique.com
SITE_URL=https://flashinfoafrique.com

# ============================================
# ANALYTICS (Optionnel)
# ============================================
# Configuration Umami Analytics ou similaire
# Laissez vide si vous n'utilisez pas d'analytics

# URL de votre instance Umami (ex: https://analytics.votre-domaine.com)
VITE_ANALYTICS_ENDPOINT=

# ID du site web dans Umami
VITE_ANALYTICS_WEBSITE_ID=

# ============================================
# ERROR TRACKING (Optionnel mais recommandé)
# ============================================
# Configuration Sentry pour le suivi des erreurs en production

# DSN Sentry (obtenez-le depuis votre projet Sentry)
VITE_SENTRY_DSN=

# Environnement Sentry (production, staging, development)
VITE_SENTRY_ENVIRONMENT=production

# ============================================
# AUTRES SERVICES (Optionnel)
# ============================================

# OAuth Portal (si utilisé pour SSO)
VITE_OAUTH_PORTAL_URL=

# App ID (identifiant unique de l'application)
VITE_APP_ID=

# Google Maps API (si cartes utilisées)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# ============================================
# RSS AUTOMATIC SCRAPING
# ============================================
# Configuration pour le scraping RSS automatique

# Secret pour sécuriser l'endpoint /api/scrape-rss
# IMPORTANT: Changez cette valeur en production !
# Utilisez: openssl rand -base64 32
CRON_SECRET=your-secret-token-change-this

# ============================================
# CONFIGURATION PRODUCTION
# ============================================
# Variables additionnelles pour la production

# Secret pour les sessions/JWT (générez une clé forte de 32+ caractères)
# Utilisez: openssl rand -base64 32
JWT_SECRET=

# Domaines autorisés pour CORS (séparés par des virgules)
CORS_ORIGINS=https://flashinfoafrique.com

# Logs level (error, warn, info, debug)
LOG_LEVEL=info
